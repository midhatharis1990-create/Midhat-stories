
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Heard, But Unheard — Stories & Support</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#232420;
    --ink-soft:#4d4f47;
    --sand:#f7f1e3;
    --sand-deep:#efe4c8;
    --green:#0b4228;
    --green-deep:#062f1c;
    --gold:#c98a2c;
    --rani:#a53860;
    --line:#dccfa8;
    --white:#fffdf8;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--sand);
    color:var(--ink);
    font-family:'Public Sans', sans-serif;
    line-height:1.6;
  }
  h1,h2,h3,.serif{
    font-family:'Fraunces', serif;
    font-weight:500;
    color:var(--ink);
    margin:0;
  }
  a{color:inherit;}
  img{max-width:100%;display:block;}

  .wrap{max-width:920px;margin:0 auto;padding:0 24px;}

  /* NAV */
  /* PAKISTAN FLAG ACCENT + TRUCK-ART BORDER */
  .flag-bar{height:6px;width:100%;background:var(--green);position:relative;}
  .flag-bar::after{
    content:"";position:absolute;top:0;right:0;height:100%;width:26%;
    background:var(--white);
  }
  .truck-border{
    height:22px;width:100%;
    background-repeat:repeat-x;background-size:44px 22px;
    background-image:
      radial-gradient(circle at 22px 4px, var(--rani) 3px, transparent 3.5px),
      radial-gradient(circle at 0px 16px, var(--gold) 2.5px, transparent 3px),
      linear-gradient(90deg, var(--green) 0 2px, transparent 2px);
    background-color:var(--sand-deep);
    border-top:1px solid var(--line);border-bottom:1px solid var(--line);
  }

    display:flex;justify-content:space-between;align-items:center;
    padding:22px 24px;max-width:920px;margin:0 auto;
  }
  .brand{font-family:'Fraunces',serif;font-size:20px;font-weight:600;letter-spacing:0.01em;}
  .brand span{color:var(--gold);}
  nav .links{display:flex;gap:28px;font-size:14px;}
  nav .links a{text-decoration:none;border-bottom:1px solid transparent;padding-bottom:2px;}
  nav .links a:hover{border-bottom-color:var(--ink);}

  /* HERO */
  header.hero{
    padding:64px 0 72px;
    border-bottom:1px solid var(--line);
    background-image:
      radial-gradient(circle at 8px 8px, var(--green) 1.4px, transparent 1.6px),
      radial-gradient(circle at 24px 24px, var(--gold) 1.2px, transparent 1.4px);
    background-size:32px 32px;
    background-position:0 0;
    position:relative;
  }
  header.hero::before{
    content:"";position:absolute;inset:0;
    background:linear-gradient(180deg, var(--sand) 0%, rgba(247,241,227,0.75) 55%, var(--sand) 100%);
    pointer-events:none;
  }
  .hero-inner{max-width:920px;margin:0 auto;padding:0 24px;position:relative;z-index:1;}
  .hero-flex{display:flex;align-items:center;gap:36px;flex-wrap:wrap;}
  .hero-text{flex:1 1 380px;}
  .hero-art{flex:0 1 260px;max-width:260px;margin:0 auto;}
  .hero-art svg{width:100%;height:auto;}
  .kicker{font-size:14px;color:var(--green-deep);margin-bottom:18px;}
  h1.hero-title{
    font-size:clamp(38px,7vw,64px);
    line-height:1.06;
    max-width:14ch;
    letter-spacing:-0.01em;
  }
  h1.hero-title::after{
    content:"";display:block;width:88px;height:5px;margin-top:22px;
    background:linear-gradient(90deg, var(--green) 0 40%, var(--gold) 40% 70%, var(--rani) 70% 100%);
  }
  .hero-title em{font-style:italic;color:var(--gold);}
  .hero-sub{
    max-width:52ch;
    margin-top:22px;
    font-size:18px;
    color:var(--ink-soft);
  }
  .hero-actions{margin-top:34px;display:flex;gap:16px;flex-wrap:wrap;}
  .btn{
    display:inline-block;padding:13px 24px;border-radius:2px;
    font-size:15px;font-weight:600;text-decoration:none;
    border:1px solid var(--ink);
  }
  .btn-solid{background:var(--ink);color:var(--white);}
  .btn-solid:hover{background:var(--gold);border-color:var(--gold);}
  .btn-outline{background:transparent;color:var(--ink);}
  .btn-outline:hover{background:var(--ink);color:var(--white);}

  /* CRISIS STRIP */
  .crisis{
    background:var(--green-deep);
    color:var(--white);
    padding:16px 0;
    font-size:14.5px;
  }
  .crisis .wrap{display:flex;flex-wrap:wrap;gap:8px 24px;align-items:baseline;}
  .crisis strong{font-weight:700;}
  .crisis a{text-decoration:underline;}

  /* SECTION HEADERS */
  section{padding:76px 0;}
  section + section{border-top:1px solid var(--line);}
  .section-head{max-width:60ch;margin-bottom:48px;}
  .section-icon{width:44px;height:44px;margin-bottom:14px;}
  .section-icon svg{width:100%;height:100%;}
  .section-head h2{font-size:clamp(26px,4vw,36px);}
  .section-head p{margin-top:14px;color:var(--ink-soft);font-size:16px;}

  /* STORIES */
  .story{
    display:grid;
    grid-template-columns:120px 1fr;
    gap:28px;
    padding:36px 0;
    border-top:1px solid var(--line);
  }
  .story:first-of-type{border-top:none;}
  .motif{
    width:52px;height:52px;border-radius:50%;
    background:var(--white);border:1.5px solid var(--line);
    display:flex;align-items:center;justify-content:center;margin-bottom:10px;
  }
  .motif svg{width:26px;height:26px;}
  .story-meta{font-size:14px;color:var(--ink-soft);}
  .story-meta .tag{
    display:inline-block;margin-top:8px;font-size:12.5px;
    color:var(--gold);border:1px solid var(--rani);
    padding:3px 9px;border-radius:2px;
  }
  .story h3{font-size:22px;margin-bottom:10px;}
  .story p{color:var(--ink-soft);font-size:16px;max-width:64ch;}
  .story .byline{margin-top:12px;font-size:14px;font-style:italic;color:var(--ink-soft);}

  .story-note{
    margin-top:44px;padding:24px;background:var(--white);
    border:1px solid var(--line);font-size:15px;color:var(--ink-soft);
  }
  .story-note strong{color:var(--ink);}

  .encourage-line{
    margin-top:14px;padding:14px 16px;
    background:var(--sand-deep);border-left:3px solid var(--rani);
    font-size:14.5px;color:var(--ink-soft);font-style:italic;
  }
  .encourage-line strong{color:var(--ink);font-style:normal;}

  /* ENCOURAGEMENT WALL */
  .notes-grid{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:18px;margin-top:8px;
  }
  .note-card{
    background:var(--white);border:1px solid var(--line);
    padding:20px;font-size:15px;color:var(--ink-soft);position:relative;
  }
  .note-card::before{
    content:"";position:absolute;top:0;left:20px;width:36px;height:4px;
    background:var(--gold);
  }
  .note-card .who{margin-top:14px;font-size:13px;color:var(--green-deep);font-weight:600;}
  .encouragement-cta{
    margin-top:36px;padding:22px;background:var(--sand-deep);
    border:1px dashed var(--line);text-align:center;font-size:15px;color:var(--ink-soft);
  }

  /* QUOTES SECTION */
  .quotes-wrap{background:var(--green-deep);color:var(--white);}
  .quote-block{
    padding:38px 0;border-top:1px solid rgba(255,255,255,0.14);
    display:grid;grid-template-columns:1fr;
  }
  .quote-block:first-of-type{border-top:none;padding-top:6px;}
  .quote-mark{
    font-family:'Fraunces',serif;font-size:56px;line-height:0.5;
    color:var(--gold);margin-bottom:14px;display:block;
  }
  .quote-text{
    font-family:'Fraunces',serif;font-style:italic;font-weight:500;
    font-size:clamp(20px,3.2vw,28px);line-height:1.35;max-width:26ch;color:var(--white);
  }
  .quote-attr{margin-top:16px;font-family:'Public Sans',sans-serif;font-style:normal;
    font-size:14px;color:#cfe0d2;letter-spacing:0.02em;}
  .quote-attr strong{color:var(--white);font-weight:600;}
  .quote-block:nth-child(even){text-align:right;}
  .quote-block:nth-child(even) .quote-text{margin-left:auto;}

  /* RESOURCES */
  .res-group{margin-bottom:44px;}
  .res-group:last-child{margin-bottom:0;}
  .res-group h3{
    font-size:15px;text-transform:none;color:var(--green-deep);
    border-bottom:1px solid var(--line);padding-bottom:10px;margin-bottom:18px;
    letter-spacing:0.02em;
  }
  .res-item{
    display:flex;justify-content:space-between;flex-wrap:wrap;gap:6px 20px;
    padding:14px 0;border-bottom:1px dashed var(--line);
  }
  .res-item:last-child{border-bottom:none;}
  .res-name{font-weight:600;font-size:15.5px;}
  .res-desc{color:var(--ink-soft);font-size:14.5px;max-width:46ch;}
  .res-contact{font-size:14.5px;color:var(--gold);white-space:nowrap;text-align:right;}

  /* SHARE CTA */
  .share{
    background:var(--ink);color:var(--white);
    padding:70px 0;
  }
  .share h2{color:var(--white);font-size:clamp(26px,4vw,36px);max-width:16ch;}
  .share p{color:#cfcac0;margin-top:16px;max-width:56ch;font-size:16px;}
  .share .btn-solid{background:var(--gold);border-color:var(--gold);margin-top:26px;}
  .share .btn-solid:hover{background:var(--rani);border-color:var(--rani);}

  /* FORMS */
  .form-row{margin-bottom:14px;}
  .encourage-form input[type="text"],
  .encourage-form textarea,
  .story-form input[type="text"],
  .story-form input[type="email"],
  .story-form textarea{
    width:100%;padding:12px 14px;font-family:'Public Sans',sans-serif;font-size:15px;
    border:1px solid var(--line);background:var(--white);color:var(--ink);
    border-radius:2px;box-sizing:border-box;
  }
  .encourage-form textarea,
  .story-form textarea{resize:vertical;}
  .encourage-form input:focus,
  .encourage-form textarea:focus{outline:none;border-color:var(--gold);}
  .story-form input[type="text"],
  .story-form input[type="email"],
  .story-form textarea{
    background:rgba(255,253,248,0.06);border-color:rgba(255,255,255,0.25);color:var(--white);
  }
  .story-form input::placeholder,
  .story-form textarea::placeholder{color:#a9a49a;}
  .story-form input[type="text"]:focus,
  .story-form input[type="email"]:focus,
  .story-form textarea:focus{outline:none;border-color:var(--gold);}

  footer{
    padding:40px 24px;text-align:center;font-size:13.5px;color:var(--ink-soft);
  }

  @media (max-width:640px){
    .story{grid-template-columns:1fr;}
    .story-meta{display:flex;gap:12px;align-items:center;}
  }
</style>
